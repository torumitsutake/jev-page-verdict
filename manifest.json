{
  "manifest_version": 3,
  "name": "Page Verdict (Jev)",
  "version": "0.1.0",
  "description": "Tells you whether the page you are on is selling something or reporting first-hand experience, using Jev.",
  "minimum_chrome_version": "116",

  "permissions": ["storage", "activeTab", "scripting", "offscreen"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "optional_host_permissions": [
    "https://www.google.com/search*",
    "https://www.google.co.jp/search*",
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Judge this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_page": "options.html"
}
